# Copie as variáveis para a sessão do terminal ou para um arquivo .env local.
# Nunca publique valores reais no GitHub.
POSTGRES_DB=cestas_da_mel
POSTGRES_USER=cestas_app
POSTGRES_PASSWORD=troque-por-uma-senha-forte
DB_URL=jdbc:postgresql://localhost:5433/cestas_da_mel
DB_USERNAME=cestas_app
DB_PASSWORD=mesma-senha-do-postgres
JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Chave secreta usada apenas pela API para ler notas fiscais. Nunca use EXPO_PUBLIC_ neste valor.
OPENROUTER_API_KEY=cole-a-chave-do-openrouter-aqui
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=180
OPENROUTER_APP_URL=http://localhost:8081
OPENROUTER_APP_TITLE=Cestas da Mel ERP
